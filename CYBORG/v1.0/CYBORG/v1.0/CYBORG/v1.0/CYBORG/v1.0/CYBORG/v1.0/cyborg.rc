// ============================================================================
// RESOURCE IDENTIFIER MANIFEST MATRIX :: CYBORG SIGNER CLI
// ============================================================================

#include <winres.h>

#define IDI_APP_ICON 101

// 1. APPLICATION VISUAL ICON MAPPING (First/lowest icon ID is shown in Explorer)
IDI_APP_ICON ICON "favicon.ico"

// 2. OFFICIAL WINDOWS FILE VERSIONING INFRASTRUCTURE
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mercwar AI\0"
            VALUE "FileDescription",  "Cyborg Digital Signature \0"
            VALUE "FileVersion",      "1.1.0.0\0"
            VALUE "InternalName",     "cyborg\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Joseph Michael Catalano, Mercwar AI. All rights reserved.\0"
            VALUE "OriginalFilename", "cyborg.exe\0"
            VALUE "ProductName",      "Cyborg Digital Signer\0"
            VALUE "ProductVersion",   "1.1\0"
            VALUE "Comments",         "Command-line client for Cyborg digital signing.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END